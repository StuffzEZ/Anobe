{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for all local Anobe windows (hub, Docs, Installer, Webapp)",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:event:default",
    "opener:default",
    "shell:allow-open",
    "fs:default",
    "deep-link:default",
    "log:default",
    "os:default",
    "window-state:default"
  ]
}
